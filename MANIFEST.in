include tests/test_smoke.py frontend/tests/state.test.mjs
include tools/build_flow_data.py
recursive-include desktop *.md *.txt *.json *.py *.spec *.c *.iss *.sh *.png *.svg *.ico GPL-3 LGPL-3 LGPL-2.1 MPL-2.0
