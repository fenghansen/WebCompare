include LICENSE NOTICE webcompare_build.py
include requirements.lock requirements-test.lock
include install.sh install.bat start.sh start.bat scripts/install.py
include frontend/package.json frontend/package-lock.json frontend/tsconfig.json frontend/index.html
recursive-include frontend/src *
recursive-include frontend/public *
